{
  "appId": "com.rtstu.screenshare.cosy.sender",
  "productName": "OpenCosyScreenShareSender",
  "directories": {
    "output": "dist/sender"
  },
  "files": [
    "sender/**/*",
    "package.json"
  ],
  "extraMetadata": {
    "main": "sender/main.js"
  },
  "electronDownload": {
    "mirror": "https://npmmirror.com/mirrors/electron/"
  },
  "win": {
    "target": [
      "nsis",
      "portable"
    ],
    "icon": "sender/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": true,
    "shortcutName": "Cosy传屏-发送端"
  }
}
